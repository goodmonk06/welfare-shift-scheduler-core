{
  "name": "welfare-shift-scheduler-core",
  "version": "0.1.0",
  "description": "介護・福祉事業所向けのシフト自動生成エンジン",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "example": "tsx src/examples/smallFacilityExample.ts",
    "seed": "tsx src/api/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "shift-scheduling",
    "healthcare",
    "optimization",
    "constraint-solver"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^1.0.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  }
}
